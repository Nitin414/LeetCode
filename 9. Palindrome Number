class Solution {
public:
    bool isPalindrome(int x) {
        if(x<0)
        {
            return false;
        }
          long long b =0;
          int a = x;
          while(x>0)
       {
          int c= x%10;
          b = b*10+c;
          x=x/10;
        }
         if (a==b)
         {
           return true;
         }
          else
          {
           return false;
         }   
    }
   
};
