class Solution {
public:
    int sumOfUnique(vector<int>& nums) {
        int k =0,a=0;
        for(int i =0; i<nums.size();i++)
        {
            k=0;
            for(int j=0;j< nums.size();j++)
            {
                if( i!=j && nums[i]==nums[j])
                {
                    k++;
                }
            }
            if(k==0)
            {
                a=a+nums[i];
            }
        }
        return a;
    }
};
