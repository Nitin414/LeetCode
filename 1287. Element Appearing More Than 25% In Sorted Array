class Solution {
public:
    int findSpecialInteger(vector<int>& arr) {
        int k=1;
        for(int i=0; i<arr.size()-1;i++)
        {
            if(arr[i]==arr[i+1])
            {
                k++;
            }
            else{
                k=1;
            }
            if(k>arr.size()/4)
            {
                return arr[i+1];
            }
        }
        return arr[0];
    }
};
